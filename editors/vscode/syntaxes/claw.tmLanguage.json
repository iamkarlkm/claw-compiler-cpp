{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Claw",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#attributes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.claw",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.claw",
          "match": "\\b(if|else|for|while|loop|return|break|continue|match|try|catch|raise|await|async|in)\\b"
        },
        {
          "name": "keyword.declaration.claw",
          "match": "\\b(fn|let|const|pub|mod|use|struct|enum|trait|impl|self|Self|serial|process|spawn|tensor)\\b"
        },
        {
          "name": "constant.language.claw",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.claw",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.claw",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.claw",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.claw",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.claw",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.claw",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|string|array|void|num)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.claw",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    }
  },
  "scopeName": "source.claw"
}
