{
  "name": "claw",
  "displayName": "Claw Language Support",
  "description": "Language support for the Claw programming language",
  "version": "0.2.0",
  "publisher": "yourusername",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["claw", "language"],
  "activationEvents": [
    "onLanguage:claw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "claw",
        "aliases": ["Claw", "claw"],
        "extensions": [".claw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "claw",
        "scopeName": "source.claw",
        "path": "./syntaxes/claw.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
