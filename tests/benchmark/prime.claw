fn is_prime(n) {
    if n <= 1 {
        return false
    }
    if n <= 3 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let i = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    return true
}

fn main() {
    let count = 0
    let n = 2
    while n < 10000 {
        if is_prime(n) {
            count = count + 1
        }
        n = n + 1
    }
    println(count)
}
